# ---- Database -------------------------------------------------------------
# PostgreSQL connection string. Local example:
#   postgresql://postgres:postgres@localhost:5432/rejoice?schema=public
# Hosted (Neon / Supabase) connection strings work unchanged.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rejoice?schema=public"

# The SAME database over an UNPOOLED connection. Used only by `prisma migrate`,
# never by the running app.
#
# Migrations take advisory locks and issue DDL, neither of which survives a
# transaction pooler, so running them over the pooled URL above hangs or fails.
# Hosted Postgres providers give you both strings; on Neon they differ only by
# `-pooler` in the hostname:
#
#   DATABASE_URL  ...-pooler.<region>.aws.neon.tech/...   (pooled, the app)
#   DIRECT_URL    ...<region>.aws.neon.tech/...           (direct, migrations)
#
# Leave BLANK for local development: the embedded Postgres has no pooler in
# front of it, so DATABASE_URL is already a direct connection.
DIRECT_URL=""

# ---- Authentication -------------------------------------------------------
# Generate with:  openssl rand -base64 32
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Used once by `npm run seed` to create the single administrator account.
# Change the password through Admin -> Settings afterwards.
ADMIN_EMAIL="admin@rejoice.local"
ADMIN_PASSWORD=""

# ---- Site -----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---- YouTube --------------------------------------------------------------
# Google Cloud console -> enable "YouTube Data API v3" -> create an API key.
# Server-side only. Never prefix this with NEXT_PUBLIC_.
YOUTUBE_API_KEY=""

# ---- YouTube Analytics (revenue, watch time, traffic sources) --------------
# OPTIONAL, and a DIFFERENT credential from the API key above. The key reads
# public data; revenue and watch time come from the YouTube Analytics API,
# which only the Google account that OWNS the channels can authorise.
#
# Google Cloud console -> enable "YouTube Analytics API" -> Credentials ->
# create an "OAuth client ID" of type "Web application", and add this as an
# authorised redirect URI:
#
#   https://<your-domain>/api/youtube/oauth/callback
#   http://localhost:3000/api/youtube/oauth/callback   (for local development)
#
# Publish the OAuth consent screen. While it is left in "Testing" status Google
# expires the refresh token every 7 days and the connection silently dies.
#
# Once these are set, connect the account at Admin -> Settings -> YouTube
# analytics. Revenue additionally requires the channel to be in the YouTube
# Partner Programme; without it the other reports still work.
YOUTUBE_OAUTH_CLIENT_ID=""
YOUTUBE_OAUTH_CLIENT_SECRET=""

# Shared secret for verifying WebSub push notifications.
# REQUIRED for push to work: /api/youtube/webhook refuses every request when this
# is unset, since without it there is no way to tell the hub from anyone else.
# Leave it empty only if you are relying on the scheduled sync alone.
YOUTUBE_WEBHOOK_SECRET=""

# ---- Scheduled sync -------------------------------------------------------
# Required. /api/youtube/sync refuses to run without it.
CRON_SECRET=""

# ---- Outgoing mail --------------------------------------------------------
# Used only to notify Rejoice that a contact enquiry has arrived. Leave these
# empty and the site behaves exactly as before: enquiries are still stored and
# still appear under Admin -> Enquiries, just with no email alert.
#
# Gmail needs an APP PASSWORD, not the account password. Turn on 2-Step
# Verification first, then create one at:
#   Google Account -> Security -> 2-Step Verification -> App passwords
#
# The alert is sent TO the contact address in Admin -> Settings, so changing it
# there changes where alerts land without a redeploy.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
